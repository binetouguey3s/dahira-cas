# URL de base de l'API Django. En local, laissez la valeur par défaut.
# En production (Vercel), définissez cette variable dans les Project Settings
# avec l'URL de votre backend déployé sur Render, par ex. :
# VITE_API_URL=https://dahira-backend.onrender.com/api
VITE_API_URL=http://127.0.0.1:8000/api
