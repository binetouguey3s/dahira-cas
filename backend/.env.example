# Copier ce fichier en ".env" et renseigner les vraies valeurs.
# Ne jamais committer le ".env" réel sur GitHub.
# Détail de chaque variable : GUIDE_DEMARRAGE.md, section 3.

SECRET_KEY=change-moi-avec-une-cle-aleatoire-longue
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Vide en local (SQLite). En production : URL PostgreSQL Neon (connexion directe, sans "-pooler").
DATABASE_URL=

# Origines autorisées à appeler l'API (le site) :
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Adresse du site utilisée dans les e-mails (facultatif) :
# FRONTEND_URL=https://dahira-cas.vercel.app

# Cloudinary (photos, audios, vidéos) — vide en local : fichiers stockés dans backend/media/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# E-mails par l'API Brevo — vide en local : les e-mails s'affichent dans le terminal
BREVO_API_KEY=
# DEFAULT_FROM_EMAIL=adresse-validee-dans-brevo@exemple.com
EMAIL_NOM_EXPEDITEUR=Dahira Cheikh Abdoulahi Seye

# Traduction automatique DeepL (clé gratuite se terminant par ":fx") — facultatif
DEEPL_API_KEY=

# Clé du robot quotidien (même valeur que le secret GitHub TACHES_CLE)
TACHES_CLE=
