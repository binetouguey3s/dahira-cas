# Copier ce fichier en ".env" et renseigner les vraies valeurs.
# Ne jamais committer le ".env" réel sur GitHub.

SECRET_KEY=change-moi-avec-une-cle-aleatoire-longue
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Laisser vide en local (SQLite utilisé par défaut).
# En production (Render), Render fournit automatiquement cette variable.
DATABASE_URL=

# Origines autorisées à appeler l'API (le frontend) :
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary (stockage audio/vidéo/photos) — laisser vide pour stocker en local :
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (secours ; les notifications passent normalement par n8n) :
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# URL du webhook n8n à appeler depuis Django (optionnel) :
N8N_WEBHOOK_URL=
